OPENAI_API_KEY=openai-api-key
# Choose a model available to your account that supports Responses Structured Outputs.
OPENAI_MODEL=your-structured-output-model
# Optional independent role overrides:
# OPENAI_EXTRACTOR_MODEL=your-interpreter-model
# OPENAI_PLANNER_MODEL=your-planner-model
# Streaming read inactivity timeout and retries before a stream starts:
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=0
# Stop an active stream after this elapsed time (checked between events):
OPENAI_REQUEST_DEADLINE_SECONDS=300
OPENAI_EXTRACTOR_MAX_OUTPUT_TOKENS=2000
OPENAI_PLANNER_MAX_OUTPUT_TOKENS=6000
# Lower reasoning effort; use default to omit this for unsupported models.
OPENAI_REASONING_EFFORT=low
# Concurrent day requests after the outline. Use 1 for sequential generation.
TRIP_PLANNER_WORKERS=3
TRIP_PLANNER_TIMEZONE=Asia/Bangkok
TRIP_PLANNER_OUTPUT_DIR=output

